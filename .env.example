# Copy only the variables for integrations you enable into your deployment's
# secret manager. Never commit real values or store them in this repository.

# Required for Trello features
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_NAME=Daily
TRELLO_CAPTURE_LIST=Inbox

# Optional AI support
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional Google Calendar and Google Tasks support
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8005/auth/google/callback
GOOGLE_TASKS_LIST_NAME=Planner

# Optional messaging integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TO=

# Local server and planning behavior
PORT=8787
PLANNER_HOST=localhost
PLANNER_API_TOKEN=
PLANNER_TIMEZONE=UTC
PLANNER_MORNING_ENABLED=true
PLANNER_IN_PROCESS_SCHEDULER=false
PLANNER_HOSTING_MONTHLY_USD=0

